generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Filme {
  id            Int      @id @default(autoincrement())
  titulo        String
  genero        String
  descricao     String
  classificacao String
  duracao       Int
  dataEstreia   String
  criadoEm     DateTime @default(now())
  sessoes       Sessao[]
}

model Sala {
  id         Int      @id @default(autoincrement())
  nome       String
  capacidade Int
  tipo       String
  criadoEm  DateTime @default(now())
  sessoes    Sessao[]
}

model Sessao {
  id        Int       @id @default(autoincrement())
  filmeId   Int
  salaId    Int
  dataHora  String
  preco     Float
  idioma    String
  formato   String
  criadoEm DateTime  @default(now())
  filme     Filme     @relation(fields: [filmeId], references: [id], onDelete: Cascade)
  sala      Sala      @relation(fields: [salaId], references: [id], onDelete: Cascade)
  ingressos Ingresso[]
}

model Ingresso {
  id        Int      @id @default(autoincrement())
  sessaoId  Int
  nome      String
  cpf       String
  assento   String
  pagamento String
  criadoEm DateTime @default(now())
  sessao    Sessao   @relation(fields: [sessaoId], references: [id], onDelete: Cascade)
}
